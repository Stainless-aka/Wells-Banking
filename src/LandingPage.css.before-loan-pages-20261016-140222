.landing {
  --landing-red: #c41230;
  --landing-ink: #242120;
  --landing-muted: #686563;
  --landing-border: #e8e3df;
  min-height: 100vh;
  color: var(--landing-ink);
  background: #fff;
  font-family: Arial, Helvetica, sans-serif;
}

.landing * { box-sizing: border-box; }
.landing a { text-decoration: none; }

.landing-disclosure {
  padding: 9px 16px;
  background: #292625;
  color: #fff;
  text-align: center;
  font-size: 10px;
  letter-spacing: .035em;
}

.landing-header {
  width: min(1160px, calc(100% - 48px));
  min-height: 84px;
  margin: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  border-bottom: 1px solid var(--landing-border);
}

.landing-brand { display: flex; align-items: center; gap: 11px; color: var(--landing-ink); }
.landing-brand-mark, .landing-small-mark {
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  color: #fff;
  background: var(--landing-red);
  font-family: Georgia, serif;
  font-weight: bold;
}
.landing-brand-mark { width: 41px; height: 41px; font-size: 27px; }
.landing-brand-copy strong, .landing-brand-copy small { display: block; }
.landing-brand-copy strong { font-family: Georgia, serif; font-size: 19px; }
.landing-brand-copy small { margin-top: 5px; font-size: 8px; letter-spacing: .13em; }

.landing-nav { display: flex; align-items: center; gap: 28px; }
.landing-nav a { color: #393534; font-size: 12px; font-weight: 600; }
.landing-nav .landing-signin { padding: 13px 22px; background: var(--landing-red); color: #fff; }

.landing-hero {
  width: min(1160px, calc(100% - 48px));
  margin: auto;
  padding: 74px 0 82px;
  display: grid;
  grid-template-columns: 1.02fr .98fr;
  align-items: center;
  gap: 52px;
}

.landing-hero-copy { max-width: 550px; }
.landing-eyebrow { color: var(--landing-red); font-size: 10px; font-weight: 700; letter-spacing: .15em; }
.landing-hero h1 {
  margin: 21px 0;
  font: 400 clamp(42px, 5vw, 62px)/1.08 Georgia, 'Times New Roman', serif;
  letter-spacing: -.045em;
}
.landing-hero-copy > p { max-width: 470px; color: var(--landing-muted); font-size: 15px; line-height: 1.9; }

.landing-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
.landing-button {
  min-height: 47px;
  padding: 0 19px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 13px;
  font-size: 12px;
  font-weight: 700;
  transition: background .15s ease, transform .15s ease;
}
.landing-button:hover { transform: translateY(-1px); }
.landing-button-red { background: var(--landing-red); color: #fff; }
.landing-button-red:hover { background: #a80e27; }
.landing-button-outline { border: 1px solid #d7d0cb; background: #fff; color: var(--landing-ink); }
.landing-assurance { display: flex; align-items: center; gap: 8px; margin-top: 24px; color: #666; font-size: 11px; }
.landing-assurance > span:first-child { color: var(--landing-red); font-size: 18px; }

.landing-hero-art {
  position: relative;
  min-height: 390px;
  display: grid;
  place-items: center;
  overflow: hidden;
  background: #f7f3f0;
}
.landing-art-circle { position: absolute; border: 1px solid rgba(196,18,48,.13); border-radius: 50%; }
.landing-art-circle-one { width: 340px; height: 340px; transform: translate(25px,-12px); }
.landing-art-circle-two { width: 260px; height: 260px; transform: translate(-25px,24px); }

.landing-account-card {
  position: relative;
  z-index: 1;
  width: min(360px, calc(100% - 36px));
  padding: 23px;
  background: #fff;
  box-shadow: 0 20px 55px rgba(38,25,22,.12);
}
.landing-account-heading { display: flex; align-items: center; gap: 9px; font-size: 10px; }
.landing-small-mark { width: 27px; height: 27px; font-size: 17px; }
.landing-menu-dots { margin-left: auto; color: #777; }
.landing-account-label { margin-top: 29px; color: #777; font-size: 9px; letter-spacing: .1em; }
.landing-account-placeholder { margin-top: 10px; font: 21px Georgia, serif; }
.landing-account-note { margin-top: 8px; color: #777; font-size: 10px; line-height: 1.6; }
.landing-card-divider { height: 1px; margin: 21px 0 6px; background: var(--landing-border); }
.landing-account-row { display: flex; align-items: center; gap: 11px; padding: 13px 0; border-bottom: 1px solid #f0edeb; }
.landing-row-icon { width: 34px; height: 34px; display: grid; place-items: center; color: var(--landing-red); background: #fbf0f1; font-size: 17px; }
.landing-account-row strong, .landing-account-row small { display: block; }
.landing-account-row strong { font-size: 11px; }
.landing-account-row small { margin-top: 5px; color: #888; font-size: 9px; }
.landing-row-arrow { margin-left: auto; color: #777; }
.landing-card-link { display: block; margin-top: 18px; color: var(--landing-red); font-size: 10px; font-weight: 700; }

.landing-floating-note {
  position: absolute;
  right: 8px;
  bottom: 26px;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 12px;
  background: #fff;
  box-shadow: 0 8px 28px rgba(38,25,22,.12);
}
.landing-floating-icon { width: 27px; height: 27px; display: grid; place-items: center; border-radius: 50%; background: #e9f5ed; color: #28734b; }
.landing-floating-note strong, .landing-floating-note small { display: block; }
.landing-floating-note strong { font-size: 10px; }
.landing-floating-note small { margin-top: 4px; color: #777; font-size: 9px; }

.landing-services { padding: 76px 24px 82px; background: #faf8f6; }
.landing-section-heading { max-width: 650px; margin: 0 auto 40px; text-align: center; }
.landing-section-heading h2, .landing-security h2, .landing-support h2 {
  margin: 15px 0 10px;
  font: 400 clamp(29px, 4vw, 40px)/1.2 Georgia, serif;
  letter-spacing: -.025em;
}
.landing-section-heading p, .landing-security p, .landing-support p { color: var(--landing-muted); font-size: 13px; line-height: 1.8; }
.landing-service-grid { width: min(1160px, 100%); margin: auto; display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 16px; }
.landing-service-card { padding: 23px; border: 1px solid var(--landing-border); background: #fff; }
.landing-service-top { display: flex; align-items: center; justify-content: space-between; }
.landing-service-icon { width: 40px; height: 40px; display: grid; place-items: center; background: #fbf0f1; color: var(--landing-red); font-size: 20px; }
.landing-service-number { color: #a7a19c; font: 15px Georgia,serif; }
.landing-service-card h3 { margin: 23px 0 10px; font: 20px Georgia,serif; }
.landing-service-card p { min-height: 86px; color: var(--landing-muted); font-size: 12px; line-height: 1.8; }
.landing-service-card a { display: inline-flex; gap: 8px; margin-top: 10px; color: var(--landing-red); font-size: 11px; font-weight: 700; }

.landing-security {
  width: min(1160px, calc(100% - 48px));
  margin: auto;
  padding: 64px 0;
  display: grid;
  grid-template-columns: 62px 1fr auto;
  align-items: center;
  gap: 24px;
  border-bottom: 1px solid var(--landing-border);
}
.landing-security-icon { width: 54px; height: 54px; display: grid; place-items: center; background: #fbf0f1; color: var(--landing-red); font-size: 27px; }
.landing-security h2 { font-size: 29px; }
.landing-security p { max-width: 620px; margin-bottom: 0; }

.landing-support {
  width: min(1160px, calc(100% - 48px));
  margin: auto;
  padding: 62px 0;
  display: grid;
  grid-template-columns: 1.2fr .8fr;
  gap: 50px;
}
.landing-support h2 { font-size: 32px; }
.landing-support-links { display: flex; flex-direction: column; justify-content: center; }
.landing-support-links a { display: flex; justify-content: space-between; padding: 15px 0; border-bottom: 1px solid var(--landing-border); color: #333; font-size: 12px; font-weight: 600; }
.landing-support-links a span { color: var(--landing-red); }

.landing-footer {
  min-height: 70px;
  padding: 20px max(24px, calc((100% - 1160px)/2));
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 14px;
  border-top: 1px solid var(--landing-border);
  color: #777;
  font-size: 10px;
}
.landing-footer a { color: inherit; }
.landing-footer .landing-footer-brand { color: var(--landing-ink); font: 16px Georgia,serif; }

@media (max-width: 900px) {
  .landing-hero { gap: 28px; }
  .landing-service-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
  .landing-service-card p { min-height: 55px; }
  .landing-security { grid-template-columns: 54px 1fr; }
  .landing-security > .landing-button { grid-column: 2; justify-self: start; }
}

@media (max-width: 650px) {
  .landing-header { width: calc(100% - 32px); min-height: 74px; }
  .landing-brand-mark { width: 36px; height: 36px; }
  .landing-brand-copy strong { font-size: 16px; }
  .landing-brand-copy small { font-size: 7px; }
  .landing-nav { gap: 12px; }
  .landing-nav > a:not(.landing-signin) { display: none; }
  .landing-nav .landing-signin { padding: 11px 15px; }
  .landing-hero { width: calc(100% - 32px); padding: 48px 0 42px; grid-template-columns: 1fr; gap: 32px; }
  .landing-hero h1 { font-size: clamp(40px, 11vw, 54px); }
  .landing-hero-copy > p { font-size: 14px; }
  .landing-hero-art { min-height: 370px; }
  .landing-floating-note { right: 4px; bottom: 12px; }
  .landing-services { padding: 52px 16px; }
  .landing-service-grid { grid-template-columns: 1fr; }
  .landing-service-card p { min-height: auto; }
  .landing-security { width: calc(100% - 32px); padding: 42px 0; grid-template-columns: 42px 1fr; gap: 14px; }
  .landing-security-icon { width: 42px; height: 42px; }
  .landing-security h2 { font-size: 25px; }
  .landing-support { width: calc(100% - 32px); padding: 42px 0; grid-template-columns: 1fr; gap: 20px; }
  .landing-support h2 { font-size: 29px; }
  .landing-footer { align-items: flex-start; flex-direction: column; padding: 22px 16px; }
}

@media (prefers-reduced-motion: reduce) {
  .landing-button { transition: none; }
}
